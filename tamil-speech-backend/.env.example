# Tamil Speech Learning Backend - Environment Configuration

# Application
APP_NAME="Tamil Speech Learning Backend"
DEBUG=false
API_VERSION="v1"

# Database (Supabase Postgres)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database
# Example: postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Provider Selection
STT_PROVIDER=azure
TTS_PROVIDER=azure
LLM_PROVIDER=groq

# Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=ta-IN

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=mixtral-8x7b-32768

# Google Cloud (Optional)
# GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json

# OpenAI (Optional)
# OPENAI_API_KEY=your-openai-api-key

# CORS Configuration
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Speech Analysis Thresholds
PHONEME_SIMILARITY_THRESHOLD=0.8
WORD_SIMILARITY_THRESHOLD=0.7
